# ai-proxy · Hugging Face Space image
# Bucket mounted at /data via Space Settings → Volumes.
FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*

RUN npm install -g git+https://github.com/Sexlovr/ai-proxy.git

RUN mkdir -p /data && chmod 777 /data

ENV PORT=7860 NODE_ENV=production DATA_DIR=/data HOME=/home/node

WORKDIR /usr/local/lib/node_modules/ai-proxy
EXPOSE 7860
CMD ["node", "server.js"]
