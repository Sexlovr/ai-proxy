# ── ai-proxy · Hugging Face Space image ──────────────────────────────
# Deploys the proxy inside an HF Docker Space with a Storage Bucket
# volume mounted at /data (read-write). See https://huggingface.co/docs/hub/storage-buckets
# and https://huggingface.co/docs/hub/storage-buckets-access ("Volume mounts in Jobs and Spaces").
#
# To enable persistence:
#   1. Create a Storage Bucket at huggingface.co/new-bucket  (e.g. <user>/ai-proxy-data)
#   2. Attach it to this Space as a volume:
#        hf spaces volumes set <user>/<space-name> \
#          -v hf://buckets/<user>/ai-proxy-data:/data
#   The bucket is mounted read-write at /data on every restart. All
#   proxy state, logs and counters live under /data.
#
# Notes:
#   * /data is only available at runtime (never during build).
#   * HF Spaces run the container as UID 1000; /data must be writable by it.
#   * No native deps → image stays tiny and rebuilds are fast.

FROM node:20-slim

ENV NODE_ENV=production \
    PORT=7860 \
    DATA_DIR=/data \
    HOME=/home/node

# /data mount-point — pre-created + world-writable (HF mounts on top of it).
# A recursive chown on /data would be wasteful; we only create the empty dir.
RUN mkdir -p /data && chmod 777 /data

# App lives in $HOME/app (UID 1000 home).
RUN mkdir -p /home/node/app && chown -R node:node /home/node/app

USER node
WORKDIR /home/node/app

# Install local deps (no native build needed).
COPY --chown=node:node package.json ./
RUN npm install --omit=dev

# Copy source.
COPY --chown=node:node server.js ./server.js
COPY --chown=node:node store ./store
COPY --chown=node:node lib ./lib
COPY --chown=node:node admin ./admin
COPY --chown=node:node public ./public

EXPOSE 7860

# Graceful shutdown: flush any debounced state writes before exit.
CMD ["node", "server.js"]
