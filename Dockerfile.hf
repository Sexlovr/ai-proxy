# ai-proxy · Hugging Face Space image
# Bucket mounted at /data via Space Settings → Volumes.
# The FUSE mount is read-only in practice (EACCES on write from any UID).
# We use `hf buckets sync` (Python CLI) to sync state to/from the bucket.
# HF_TOKEN + SPACE_ID are auto-injected by HF Spaces — NO extra secrets needed.
FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates python3 python3-pip && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir --break-system-packages huggingface_hub

RUN npm install -g git+https://github.com/Sexlovr/ai-proxy.git

RUN mkdir -p /data /home/node/.cache \
    && chown -R node:node /usr/local/lib/node_modules/ai-proxy /data /home/node

ENV HOME=/home/node PORT=7860 NODE_ENV=production DATA_DIR=/data

USER node
WORKDIR /usr/local/lib/node_modules/ai-proxy
EXPOSE 7860
CMD ["node", "server.js"]
